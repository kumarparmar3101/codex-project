{
  "name": "codex-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/lint.js",
    "typecheck": "node scripts/typecheck.js",
    "test": "node --test tests/**/*.test.js",
    "build": "node scripts/build.js",
    "seed": "node scripts/seed.js",
    "sync:branches": "node scripts/syncBranches.js",
    "build:monorepo": "turbo run build",
    "dev:monorepo": "turbo run dev --parallel",
    "lint:monorepo": "turbo run lint",
    "typecheck:monorepo": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  }
}
